NODE_ENV=development
APP_ENV=local
PORT=3005
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
AUTH_OTP_EMAIL=thecodeguyy@gmail.com

DB_HOST=
DB_NAME=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_SSL=true
# Prisma accepts DATABASE_URL directly, or the DB_* values above.
DATABASE_URL=postgresql://user:password@host:5432/paygidi?sslmode=require

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
JWT_SECRET=

# Email Configuration
EMAIL_HOST=
EMAIL_PORT=
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# SMS Configuration (Termii)
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Termii
TERMII_CHANNEL=generic

# Email provider (Resend)
RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=PayGidi <noreply@send.paygidi.site>
RESEND_REGISTER_FROM_EMAIL=PayGidi <hello@send.paygidi.site>
RESEND_NOTIFICATION_FROM_EMAIL=PayGidi <notification@send.paygidi.site>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
