NODE_ENV=production
APP_ENV=staging
PORT=3005
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1

# Dedicated staging PostgreSQL database. Do not use production credentials here.
DATABASE_URL=postgresql://staging_user:staging_password@staging-db-host:5432/paygidi_staging?sslmode=require

JWT_SECRET=replace-with-a-staging-only-secret
JWT_REFRESH_SECRET=replace-with-a-staging-only-refresh-secret

TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=Termii
TERMII_CHANNEL=dnd

RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=PayGidi Staging <noreply@send.paygidi.site>
RESEND_REGISTER_FROM_EMAIL=PayGidi Staging <hello@send.paygidi.site>
RESEND_NOTIFICATION_FROM_EMAIL=PayGidi Staging <notification@send.paygidi.site>
