NODE_ENV=production
APP_ENV=production
PORT=3005
ALLOWED_ORIGINS=https://paygidi.com,https://www.paygidi.com
TRUST_PROXY_HOPS=1

# Dedicated production PostgreSQL database. Store the real value in Vercel secrets.
DATABASE_URL=postgresql://production_user:production_password@production-db-host:5432/paygidi?sslmode=require

JWT_SECRET=replace-with-a-production-only-secret
JWT_REFRESH_SECRET=replace-with-a-production-only-refresh-secret

TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=PayGidi
TERMII_CHANNEL=dnd

RESEND_API_KEY=
RESEND_DEFAULT_FROM_EMAIL=PayGidi <noreply@send.paygidi.site>
RESEND_REGISTER_FROM_EMAIL=PayGidi <hello@send.paygidi.site>
RESEND_NOTIFICATION_FROM_EMAIL=PayGidi <notification@send.paygidi.site>
